{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanTaskBrief",
  "type": "object",
  "required": [
    "project_name",
    "scientific_target",
    "raw_input_expression_location",
    "desired_physical_basis",
    "known_benchmark",
    "allowed_operations",
    "forbidden_operations",
    "claim_boundary",
    "stopping_criteria"
  ],
  "properties": {
    "project_name": { "type": "string", "minLength": 1 },
    "scientific_target": { "type": "string", "minLength": 1 },
    "raw_input_expression_location": { "type": "string", "minLength": 1 },
    "desired_physical_basis": { "type": "array", "items": { "type": "string" } },
    "known_benchmark": { "type": "array", "items": { "type": "string" } },
    "allowed_operations": { "type": "array", "items": { "type": "string" } },
    "forbidden_operations": { "type": "array", "items": { "type": "string" } },
    "claim_boundary": {
      "type": "object",
      "required": ["allowed_claims", "forbidden_claims"],
      "properties": {
        "allowed_claims": { "type": "array", "items": { "type": "string" } },
        "forbidden_claims": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "stopping_criteria": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

