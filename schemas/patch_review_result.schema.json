{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchReviewResult",
  "description": "Reviewer result schema used by the agent dispatcher (TASK_026).",
  "type": "object",
  "required": [
    "verdict",
    "blocking_issues",
    "caveats",
    "recommended_next_action",
    "safe_to_continue"
  ],
  "properties": {
    "verdict": {
      "enum": ["PASS", "PASS_WITH_CAVEAT", "FAIL"]
    },
    "blocking_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "caveats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_action": {
      "type": "string",
      "minLength": 1
    },
    "safe_to_continue": {
      "type": "boolean"
    },
    "human_boundary_assessment": {
      "type": "string"
    },
    "required_followups": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_evidence_assessment": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
