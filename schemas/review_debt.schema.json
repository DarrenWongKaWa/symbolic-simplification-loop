{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewDebt",
  "type": "object",
  "required": [
    "stage_id",
    "stage_status",
    "status",
    "reason",
    "risk_level",
    "review_lane",
    "allowed_to_advance",
    "blocking_before",
    "required_resume_command"
  ],
  "properties": {
    "stage_id": {"type": "string", "minLength": 1},
    "stage_status": {"type": "string", "enum": ["PROVISIONAL_FREEZE_WITH_REVIEW_DEBT", "REVIEW_DEBT_BLOCKED", "REVIEW_DEBT_BLOCKING", "REVIEW_DEBT_SETTLED", "PENDING_REVIEW_RESUME"]},
    "status": {"type": "string", "enum": ["OPEN", "SETTLED", "BLOCKING"]},
    "reason": {"type": "string"},
    "risk_level": {"type": ["string", "null"]},
    "review_lane": {"type": ["string", "null"]},
    "allowed_to_advance": {"type": "boolean"},
    "review_debt": {"type": "boolean"},
    "blocking_before": {"type": "array", "items": {"type": "string"}},
    "required_resume_command": {"type": "string"}
  },
  "additionalProperties": true
}
